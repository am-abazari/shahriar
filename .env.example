# نشانی پستگرس. روی ورسل با افزودن Neon به‌صورت خودکار تنظیم می‌شود.
# اگر خالی بماند، در حالت توسعه یک پستگرس محلی در .data/pg بالا می‌آید.
DATABASE_URL=

# رمز نخستین ورود ادمین. پس از نخستین ورود می‌توانید از خودِ برنامه عوضش کنید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# کلید امضای نشست‌ها و رمزگذاری اعتبارنامه. یک رشته‌ی تصادفی بلند بگذارید.
# با دستور زیر می‌توانید یکی بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
